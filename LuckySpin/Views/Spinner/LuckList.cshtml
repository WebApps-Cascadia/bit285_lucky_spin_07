@model LuckySpin.ViewModels.LuckList
@{
    Layout = "_Layout";
}
<h1>All Your Luck</h1>
<table>
    <thead><tr><th>Name</th><th>Winner</th><th>Balance</th></tr></thead>
    <tbody>
        @foreach (LuckySpin.ViewModels.PlayerSpin playerspin in Model.PlayerSpins)
            {
            <tr>
                <td>@playerspin.Spin.Player.FirstName</td>
                <td>@playerspin.Spin.IsWinning</td>
                <td>@playerspin.balance</td>
            </tr>
        }
    </tbody>
</table>